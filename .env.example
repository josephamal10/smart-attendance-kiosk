# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./technerdz.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Minutes after check-in before a second scan counts as check-out
MIN_CHECKOUT_MINUTES=5
# Face match strictness (lower = stricter)
FACE_MATCH_TOLERANCE=0.5
# Comma-separated origins, only if you add a web frontend
CORS_ORIGINS=
