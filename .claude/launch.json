{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "demo-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["scripts/run_demo.py"],
      "port": 8001
    },
    {
      "name": "web-ui",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "5180", "--bind", "127.0.0.1", "--directory", "technerdz_app/build/web"],
      "port": 5180,
      "url": "http://localhost:5180"
    }
  ]
}
