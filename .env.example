# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./technerdz.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Face match: SFace cosine similarity needed to accept (higher = stricter)
FACE_MATCH_THRESHOLD=0.45
# Face anti-spoofing (see ml/antispoof/README.md)
ANTISPOOF_ENABLED=true
# Leave unset to use models/antispoof/threshold.json (from evaluate.py --save-threshold), else 0.5
# ANTISPOOF_THRESHOLD=0.5
ANTISPOOF_VARIANT=fp32
# Comma-separated origins, only if you add a web frontend
CORS_ORIGINS=

# Daily HR email (Gmail). Create an App Password at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification), then paste it here. Never commit the real .env.
# Office hours, HR recipients and the send time are set in the dashboard → Settings.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
